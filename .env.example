# API
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hartsystem
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h

# Clerk auth (API) — use sk_live/pk_live keys in production.
# Provisioning: members of your Clerk ORGANIZATION are provisioned automatically
# (org:admin -> super_admin). See docs/CLERK_PROVISIONING.md for the full flow.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Just-in-time provisioning (dev fallback): unknown Clerk users with no org
# membership are auto-added to this org.
CLERK_JIT_ORG_SLUG=faeheart-survey-co
CLERK_JIT_ROLE=super_admin
# Lockdown: when set, ONLY these emails may claim tenancy (JIT provisioning and
# first-time Clerk-org linking). Comma-separated, case-insensitive. Leave empty
# in local dev; set in production to your team's emails.
CLERK_JIT_ALLOWED_EMAILS=

# Web
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
