# ── API ──────────────────────────────────────────────────────────
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hartsystem

# Calibration photo uploads (Vercel Blob). Uploads fail without it.
BLOB_READ_WRITE_TOKEN=

# Browser origin(s) allowed to call the API, comma-separated. When set, CORS is
# restricted to these and Clerk session tokens are pinned to them. Leave empty
# in local dev; SET THIS IN PRODUCTION.
WEB_ORIGIN=

# ── Clerk auth ───────────────────────────────────────────────────
# Use sk_live/pk_live keys in production.
# Members of your Clerk ORGANIZATION are provisioned automatically
# (org:admin -> super_admin). See docs/CLERK_PROVISIONING.md for the full flow.
CLERK_SECRET_KEY=sk_test_...

# Lockdown for tenancy claiming — JIT provisioning and first-time Clerk-org
# linking. Comma-separated, case-insensitive.
#
# Entries may be a full address or a whole domain written with a leading "@":
#   CLERK_JIT_ALLOWED_EMAILS=@qcells.com,you@yourcompany.com
#
# NOTE: this gates CREATING a company, not joining one. Once a company exists
# and is linked to its Clerk organization, every member of that Clerk org is
# provisioned automatically and this list is not consulted — so it is a one-time
# setup per customer, not per person.
#
# IMPORTANT: in production an EMPTY value means nobody may claim tenancy. That
# is deliberate: claiming grants super_admin over an organization's data, so
# failing open would let any Clerk sign-up adopt an existing tenant. Set this to
# your team's emails before relying on either provisioning path in production.
CLERK_JIT_ALLOWED_EMAILS=

# Just-in-time provisioning — DEV CONVENIENCE ONLY. Unknown Clerk users with no
# org membership get auto-added to this org. In production this does nothing
# unless CLERK_JIT_ALLOWED_EMAILS lists the address.
CLERK_JIT_ORG_SLUG=faeheart-survey-co
CLERK_JIT_ROLE=super_admin

# ── Web ──────────────────────────────────────────────────────────
# Both are required at BUILD time — the build fails without them rather than
# shipping a blank page.
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
